# Backend environment (Flask) — Mishra Transport Agency
#
# The app reads PORT, CACHE_FILE, VEHICLE_API_URL, MONGODB_URI and
# MONGODB_DB from the environment (see vehicle_api.py). Flask does NOT
# auto-load this file — it documents what to set where.
#
# Render: set these in the dashboard. PORT is injected by Render
# automatically.
#
# Local dev: prefix on the command line instead:
#   PORT=5001 python vehicle_api.py

# Local development (frontend expects the backend on :5001):
# PORT=5001

# Render dashboard values:
# FLASK_ENV=production
# CACHE_FILE=/tmp/vehicle_cache.json

# Chola IP block fix (REQUIRED on Render — Chola returns HTTP 406 to
# Render's US datacenter IPs):
#   1. Deploy the vehicle_api/ folder to Vercel — Root Directory
#      "vehicle_api", function region Mumbai (bom1). See
#      vehicle_api/README.md.
#   2. Set the deployed URL here (no trailing slash needed):
# VEHICLE_API_URL=https://<your-vehicle-api>.vercel.app
# Unset -> the backend calls Chola directly (fine for local dev from an
# unblocked IP).

# Optional MongoDB (Atlas) cache — survives Render redeploys/restarts
# (the /tmp file cache does not). Unset -> file cache.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# MONGODB_DB=mishra_transport
