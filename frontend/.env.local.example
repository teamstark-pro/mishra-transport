# Frontend environment (Next.js) — Mishra Transport Agency
#
# Next.js auto-loads .env.local in local dev:  cp .env.local.example .env.local
# On Vercel, set this in Project Settings → Environment Variables instead
# (it is baked in at build time, so set it before the first deploy).

# Local dev — backend running on :5001 (PORT=5001 python vehicle_api.py):
NEXT_PUBLIC_VEHICLE_API=http://localhost:5001

# Production — your Render backend URL:
# NEXT_PUBLIC_VEHICLE_API=https://mishra-transport-backend.onrender.com
