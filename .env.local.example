# ===== FRONTEND (Vercel or Netlify) =====
# Set this as a platform environment variable in the dashboard, then redeploy.
# Do NOT commit the real value to git.
#
# Local dev:
#   NEXT_PUBLIC_VEHICLE_API=http://localhost:5001
#
# Production (example):
#   NEXT_PUBLIC_VEHICLE_API=https://mishra-transport-backend.onrender.com
#
NEXT_PUBLIC_VEHICLE_API=https://PLACEHOLDER_REPLACE_WITH_YOUR_RENDER_BACKEND_URL

# ===== BACKEND (Render) =====
# These are set in the Render dashboard, not here.
#
# PORT                 -> set by Render automatically
# FLASK_ENV            -> production
# CACHE_FILE           -> /tmp/vehicle_cache.json
# CHOLA_API_URL        -> optional: override the Chola endpoint
# MONGODB_URI          -> optional: your MongoDB Atlas connection string
