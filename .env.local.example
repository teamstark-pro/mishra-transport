# Frontend → backend URL.
# Local dev:
#   NEXT_PUBLIC_VEHICLE_API=http://localhost:5001
#
# Vercel / Netlify (set as a platform environment variable, not in source):
#   NEXT_PUBLIC_VEHICLE_API=https://<your-render-backend-url>
#
# Example real value (replace with your Render backend URL):
#   NEXT_PUBLIC_VEHICLE_API=https://mishra-transport-backend.onrender.com
